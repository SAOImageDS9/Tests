# Region file format: DS9 version 4.1
global color=green dashlist=8 3 width=1 font="helvetica 10 normal roman" select=1 highlite=1 dash=0 fixed=0 edit=1 move=1 delete=1 include=1 source=1
image
# glyph(400,500,{regions/glyph_star.png})
# glyph(500,500,{regions/glyph_star.png},64,0) color=red text={big}
# glyph(600,500,{regions/glyph_dot.png},20,10) width=2 tag={dots}
# glyph(400,600,{regions/glyph_missing.png},24,24)
# -glyph(500,600,{regions/glyph_dot.png},0,32) font="times 12 bold roman" text={excluded}
circle(600,600,20)
