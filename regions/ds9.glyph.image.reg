# Region file format: DS9 version 4.1
global color=green dashlist=8 3 width=1 font="helvetica 10 normal roman" select=1 highlite=1 dash=0 fixed=0 edit=1 move=1 delete=1 include=1 source=1
image
point(400,500) # point=glyph {glyph_star.png}
point(500,500) # point=glyph 64 {glyph_star.png} color=red text={big}
point(600,500) # point=glyph 20 {glyph_dot.png} width=2 tag={dots}
point(400,600) # point=glyph 24 {glyph_missing.png}
-point(500,600) # point=glyph 32 {glyph_dot.png} font="times 12 bold roman" text={excluded}
circle(600,600,20)
